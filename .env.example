# Host ports (change if already taken on your machine)
WEB_HOST_PORT=3000
API_HOST_PORT=8000
DB_HOST_PORT=5433

# PostgreSQL (container "db")
POSTGRES_USER=recsys
POSTGRES_PASSWORD=recsys
POSTGRES_DB=recsys

# Backend (container "api")
DATABASE_URL=postgresql+psycopg://recsys:recsys@db:5432/recsys
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:8b
EMBED_MODEL=bge-m3
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Set true when serving the application over HTTPS.
SESSION_COOKIE_SECURE=false
ADMIN_TOKEN=change-me
ARTIFACTS_DIR=/app/artifacts
DATA_DIR=/app/data

# Frontend (container "web"): where Next.js proxies /api/*
API_INTERNAL_URL=http://api:8000
